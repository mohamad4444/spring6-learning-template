# Docker Compose reads .env; a local Java process does not load it automatically.
DB_USERNAME=springtemplate
DB_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=local-root-only-change-me
MONGO_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=springtemplate
RABBITMQ_PASSWORD=local-only-change-me
APP_PORT=8080
# App container only; add mongo,messaging when those Compose profiles are enabled.
SPRING_PROFILES_ACTIVE=dev,postgresql
# Required for a local production JVM:
# DB_URL=jdbc:postgresql://localhost:5432/springtemplate
# JWT_ISSUER_URI=https://your-identity-provider.example/realms/template
# JWT_AUDIENCE=springtemplate
